---
import Heading from '../../ui/components/Heading.astro';
import Line from '../../ui/components/Line.astro';
import LogoBanner from '../../ui/components/LogoBanner.astro';
import Layout from '../../ui/layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
const screenshots = [
  `${base}games/pyrebound/image_3.png`,
  `${base}games/pyrebound/image_4.png`,
  `${base}games/pyrebound/image_6.png`,
  `${base}games/pyrebound/image_7.png`,
  `${base}games/pyrebound/image_8.png`,
  `${base}games/pyrebound/image_10.png`,
  `${base}games/pyrebound/image_11.png`,
  `${base}games/pyrebound/image_12.png`,
  `${base}games/pyrebound/image_13.png`,
  `${base}games/pyrebound/image_13-1.png`,
  `${base}games/pyrebound/image_14.png`,
  `${base}games/pyrebound/image_15.png`,
  `${base}games/pyrebound/image_17.png`,
  `${base}games/pyrebound/image_19.png`,
  `${base}games/pyrebound/image_21.png`,
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: 'Pyrebound',
  description:
    'A top-down exploration adventure where you bring hope back into a world of darkness by burning magical pyres made from the corpses of the undead.',
  genre: ['Exploration', 'Adventure', 'Tower Defense'],
  gamePlatform: 'PC',
  applicationCategory: 'Game',
  author: {
    '@type': 'Organization',
    name: 'Threshold Sun Games',
    url: 'https://thresholdsungames.com',
    founder: 'Fabian Schocke',
    foundingDate: '2026',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Threshold Sun Games',
    url: 'https://thresholdsungames.com',
  },
  numberOfPlayers: {
    '@type': 'QuantitativeValue',
    unitCode: 'NMB',
    value: 1,
  },
  playMode: 'SinglePlayer',
  audience: {
    '@type': 'PeopleAudience',
    requiredMinAge: 4,
  },
};
---

<Layout
  navLinks={[{ label: 'Home', href: base }]}
  title="Pyrebound // Threshold Sun Games"
  description="A top-down exploration adventure where you push back the darkness by burning pyres — a non-stationary tower defense loop set in a mythological world. By Threshold Sun Games."
  ogImage={new URL('games/pyrebound/splash_main_torch.png', Astro.site).href}
  jsonLd={jsonLd}
>
  <LogoBanner alt="Threshold Sun Games" />
  <Line />
  <!-- Title logotype -->
  <div class="flex justify-center px-4 py-2">
    <h1 class="sr-only">Pyrebound</h1>
    <img
      src={`${base}games/pyrebound/title_type_main.png`}
      alt="Pyrebound"
      class="w-full max-w-sm"
    />
  </div>

  <!-- Tagline -->
  <section class="px-4 py-2">
    <p class="text-xl font-mono font-medium leading-snug text-center">
      Light can be found even in the darkest of all hours.
    </p>
  </section>

  <!-- Elevator Pitch -->
  <section class="px-4 py-2">
    <p class="text-base leading-relaxed text-foreground text-center">
      <strong>Pyrebound</strong> is a <strong>top-down exploration adventure</strong> game in which the
      player is always trying to move further into the darkness by burning
      <strong>pyres made from corpses of the undead</strong> in an unconventional,
      <strong>non-stationary tower defense</strong>-style loop.
    </p>
  </section>

  <!-- Value Prop & Emotional Core -->
  <Heading index="01" text="What It Feels Like" />
  <section class="px-4 py-2 pb-6">
    <div class="space-y-4 text-base leading-relaxed text-foreground">
      <p>
        The game offers a <strong>strategic experience</strong> about constantly
        <strong>balancing safety, defense, offense and mobility</strong> in order to be able to
        <strong>explore</strong> the world covered by pitch-black,
        <strong>opaque darkness until lit</strong> by the pyres.
      </p>
    </div>
  </section>

  <!-- Summary -->
  <Heading index="02" text="The World" />
  <section class="px-4 py-2 pb-6">
    <div class="flex flex-col sm:flex-row gap-8 items-start">
      <div class="space-y-4 text-base leading-relaxed text-foreground flex-1">
        <p>
          Embody a mythological fire spirit tasked with fighting against the ever-encroaching
          Darkness and rekindling hope in the darkest of all hours.
        </p>
        <p>
          Explore the remnants of an ancient world while constantly driven to restless flight by the
          darkness and the desiccated undead. Survive to find the lost embers of inspiration and
          relight the beacons, then return to safety or confront the grand shadows of the world.
        </p>
        <p>
          Build, burn and sustain magical pyres made of the corpses of the Desiccated that hunt you
          to push away the darkness for a brief time. Keep moving and slowly uncover a mysterious
          history of ancient technology and crude sorcery.
        </p>
      </div>
      <img
        src={`${base}games/pyrebound/splash_main_torch.png`}
        alt="The fire spirit surrounded by flames"
        class="w-full sm:w-60 sm:shrink-0 object-cover"
        loading="lazy"
      />
    </div>
  </section>

  <!-- Gameplay Breakdown -->
  <Heading index="03" text="Gameplay" />
  <section class="px-4 py-2 pb-6">
    <div class="grid gap-6 sm:grid-cols-3 py-2 pb-4">
      <!-- Hub -->
      <div class="space-y-2">
        <h3 class="text-sm font-mono uppercase text-muted">Hub</h3>
        <p class="text-base leading-relaxed text-foreground">
          Get to know the cast of survivors in the Glimmering Glade. Bring them hope, so despair may
          give way to courage and heart.
        </p>
      </div>
      <!-- Exploration -->
      <div class="space-y-2">
        <h3 class="text-sm font-mono uppercase text-muted">Exploration</h3>
        <p class="text-base leading-relaxed text-foreground">
          Explore four hand-crafted areas drenched in darkness. Slay the Desiccated to build pyres
          and uncover what's hidden. With enough embers, light the beacons to summon the shadows.
        </p>
      </div>
      <!-- Finale -->
      <div class="space-y-2">
        <h3 class="text-sm font-mono uppercase text-muted">Finale</h3>
        <p class="text-base leading-relaxed text-foreground">
          After all beacons are lit, one final area awaits. Summon all hope, any who enter here.
        </p>
      </div>
    </div>
  </section>

  <!-- The Loop -->
  <Heading index="04" text="The Loop" />
  <section class="pl-6 sm:pl-8 mt-2 flex flex-col sm:flex-row gap-8 items-center">
    <div class="space-y-3 flex-1">
      <ol class="space-y-2 text-base text-foreground">
        {
          [
            'Enemies attack — kill enemies.',
            'Throw corpses into a pile before they reanimate.',
            'Choose a pyre type to kindle.',
            'While the pyre burns, it fights for you.',
            'Sustain pyres with additional corpses.',
          ].map((step, i) => (
            <li class="flex gap-3 items-baseline">
              <span class="font-mono text-muted/70 shrink-0 text-xs">
                {String(i + 1).padStart(2, '0')} /
              </span>
              <span>{step}</span>
            </li>
          ))
        }
      </ol>
    </div>
    <img
      src={`${base}games/pyrebound/splash_secondary.png`}
      alt="A figure holding a torch, surrounded by the Desiccated"
      class="w-full sm:w-56 sm:shrink-0 object-cover"
      loading="lazy"
    />
  </section>

  <!-- Screenshots Carousel -->
  <Heading index="05" text="Screenshots" />
  <section class="py-2 pb-6 border-b border-border">
    <div
      class="relative"
      id="pyrebound-carousel"
      tabindex="0"
      aria-label="Screenshot carousel — use arrow keys to navigate"
    >
      <!-- Embla viewport -->
      <div class="overflow-hidden" id="embla-viewport">
        <div class="flex" id="embla-container">
          {
            screenshots.map((src, i) => (
              <div class="embla__slide min-w-0 flex-[0_0_100%]">
                <img
                  src={src}
                  alt={`Pyrebound screenshot ${i + 1}`}
                  class="w-full aspect-video object-cover"
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              </div>
            ))
          }
        </div>
      </div>

      <!-- Prev / Next buttons -->
      <button
        id="embla-prev"
        aria-label="Previous screenshot"
        class="absolute left-2 top-1/2 -translate-y-1/2 z-10 flex h-8 w-8 items-center justify-center border border-border bg-background/80 backdrop-blur-sm text-foreground hover:bg-card transition-colors font-mono text-sm"
      >
        ←
      </button>
      <button
        id="embla-next"
        aria-label="Next screenshot"
        class="absolute right-2 top-1/2 -translate-y-1/2 z-10 flex h-8 w-8 items-center justify-center border border-border bg-background/80 backdrop-blur-sm text-foreground hover:bg-card transition-colors font-mono text-sm"
      >
        →
      </button>
    </div>

    <!-- Dot indicators -->
    <div class="flex justify-center gap-2 mt-4 px-4" id="embla-dots">
      {
        screenshots.map((_, i) => (
          <button
            class="embla-dot h-1 w-4 bg-border transition-colors hover:bg-muted"
            aria-label={`Go to screenshot ${i + 1}`}
            data-index={i}
          />
        ))
      }
    </div>
  </section>
</Layout>

<script>
  import EmblaCarousel from 'embla-carousel';

  const viewport = document.getElementById('embla-viewport') as HTMLElement;
  const prevBtn = document.getElementById('embla-prev') as HTMLButtonElement;
  const nextBtn = document.getElementById('embla-next') as HTMLButtonElement;
  const dotsContainer = document.getElementById('embla-dots') as HTMLElement;

  if (viewport && prevBtn && nextBtn && dotsContainer) {
    const embla = EmblaCarousel(viewport, { loop: true, dragFree: false });
    const dots = Array.from(dotsContainer.querySelectorAll<HTMLButtonElement>('.embla-dot'));

    function updateDots(index: number) {
      dots.forEach((dot, i) => {
        dot.classList.toggle('bg-primary', i === index);
        dot.classList.toggle('bg-border', i !== index);
      });
    }

    embla.on('select', () => updateDots(embla.selectedScrollSnap()));

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const index = Number(dot.dataset.index);
        embla.scrollTo(index);
      });
    });

    prevBtn.addEventListener('click', () => embla.scrollPrev());
    nextBtn.addEventListener('click', () => embla.scrollNext());

    const carousel = document.getElementById('pyrebound-carousel') as HTMLElement;
    carousel.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        embla.scrollPrev();
      }
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        embla.scrollNext();
      }
    });

    updateDots(0);
  }
</script>
