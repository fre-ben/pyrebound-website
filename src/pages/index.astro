---
import Layout from '../ui/layouts/Layout.astro';
import Heading from '../ui/components/Heading.astro';
import ContactForm from '../ui/components/ContactForm.astro';
import LogoBanner from '../ui/components/LogoBanner.astro';
import SocialLinks from '../ui/components/SocialLinks.astro';
import Funding from '../ui/components/Funding.astro';
import Projects from '../ui/components/Projects.astro';
import '../styles/style.css';

const navLinks = [
  { label: 'Socials', href: '#socials' },
  { label: 'Funding', href: '#funding' },
  { label: 'Projects', href: '#projects' },
];

const hero = {
  heroTitle: 'Mehrere Marken.\nEine Plattform.\nGrenzenlos skalierbar.',
  heroSubtitle:
    'MultiLaunch ist ein leistungsstarkes Template auf Basis von Astro — ideal für Startups und mittelgroße Händler, die mehrere Marken effizient und kostengünstig verwalten möchten.',
  ctas: [
    { label: 'Marken entdecken', url: '#brands', variant: 'primary' as const },
    { label: 'Kontakt aufnehmen', url: '#contact', variant: 'secondary' as const },
  ],
};

const brands = [
  { name: 'Alpha Brand', productType: 'Elektronik', href: '#' },
  { name: 'Beta Brand', productType: 'Mode', href: '#' },
  { name: 'Gamma Brand', productType: 'Sport', href: '#' },
  { name: 'Delta Brand', productType: 'Lifestyle', href: '#' },
];

const form = {
  title: 'Starten Sie noch heute',
  subtitle: 'Nehmen Sie Kontakt auf und erfahren Sie, wie wir Ihnen helfen können.',
  submitUrl: '#',
  submitLabel: 'Absenden',
  emailLabel: 'E-Mail',
  emailPlaceholder: 'ihre@email.de',
  messageLabel: 'Nachricht',
  messagePlaceholder: 'Wie können wir helfen?',
  logos: [{ label: 'Astro' }, { label: 'Vercel' }],
  companyTitle: 'Powered by',
  companyName: 'Threshold Sun Games',
};
---

<Layout
  title="Threshold Sun Games"
  siteName="Threshold Sun Games"
  copyrightText="Alle Rechte vorbehalten."
  navLinks={navLinks}
>
  <LogoBanner
    srcDark="/logo/white_solo_512w.png"
    srcLight="/logo/black_solo_512w.png"
    alt="Threshold Sun Games"
  />

  <Heading index="01" text="Socials" />
  <SocialLinks />

  <Heading index="02" text="Funding" />
  <Funding />

  <Heading index="03" text="Projects" />
  <Projects />

  <Heading index="04" text="Kontakt" />
  <div id="contact about">
    <ContactForm form={form} />
  </div>
</Layout>
