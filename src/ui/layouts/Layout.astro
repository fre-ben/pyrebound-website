---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Line from '../components/Line.astro';
import '../../styles/style.css';

interface NavLink {
  label: string;
  href: string;
}

interface Props {
  navLinks?: NavLink[];
  primaryColor?: string;
  title?: string;
  description?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown>;
}

const {
  navLinks = [],
  primaryColor,
  title = 'Threshold Sun Games',
  description = 'Threshold Sun Games — an indie game studio creating atmospheric exploration adventures.',
  ogImage,
  jsonLd,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const defaultOgImage = new URL('logo/white_solo_512w.png', Astro.site).href;
const resolvedOgImage = ogImage ?? defaultOgImage;
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}favicon.png`} />
    <title>Threshold Sun Games</title>
    <link
      rel="preload"
      href={`${import.meta.env.BASE_URL}fonts/open-sans-latin.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={`${import.meta.env.BASE_URL}fonts/geist-mono-latin.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:locale" content="en_US" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline src={`${import.meta.env.BASE_URL}scripts/main.js`}></script>
  </head>
  <body
    style={primaryColor ? `--color-primary: ${primaryColor};` : undefined}
    class="font-sans bg-background text-foreground bg-[url('data:image/svg+xml,%3Csvg%20width%3D%221197%22%20height%3D%221197%22%20viewBox%3D%220%200%201197%201197%22%20fill%3D%22none%22%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%3E%3Ccircle%20opacity%3D%220.4%22%20cx%3D%22598.5%22%20cy%3D%22598.5%22%20r%3D%22597.5%22%20stroke%3D%22%23E3E3E3%22/%3E%3C/svg%3E')] dark:bg-[url('data:image/svg+xml,%3Csvg%20width%3D%221197%22%20height%3D%221197%22%20viewBox%3D%220%200%201197%201197%22%20fill%3D%22none%22%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%3E%3Ccircle%20opacity%3D%220.8%22%20cx%3D%22598.5%22%20cy%3D%22598.5%22%20r%3D%22597.5%22%20stroke%3D%22%23454654%22/%3E%3C/svg%3E')] bg-[center_top_3.75rem] bg-no-repeat selection:bg-primary selection:text-primary-foreground"
  >
    <svg width="0" height="0" style="display:none" xmlns="http://www.w3.org/2000/svg">
      <symbol
        id="star"
        viewBox="0 0 24 24"
        fill="currentColor"
        stroke-width="1"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polygon
          points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
        ></polygon>
      </symbol>
    </svg>
    <div
      class="grid min-h-screen grid-rows-[auto_1fr_auto] grid-cols-[minmax(1em,1fr)_minmax(0,var(--outer-container-width))_minmax(1em,1fr)]"
    >
      <Header navLinks={navLinks} />
      <main class="col-start-2 bg-background border-x border-border">
        <slot />
        <Line />
      </main>
      <Footer />
    </div>
  </body>
</html>
