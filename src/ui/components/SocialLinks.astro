---
import { Icon } from 'astro-icon/components';

interface SocialLink {
  label: string;
  href: string;
  icon: string;
}

interface Props {
  links?: SocialLink[];
}

const {
  links = [
    { label: 'LinkedIn', href: 'https://www.linkedin.com/in/fabsch', icon: 'pixel:linkedin' },
    { label: 'Twitch', href: 'https://www.twitch.tv/indrome', icon: 'pixel:twitch' },
    { label: 'itch.io', href: 'https://indrome.itch.io/', icon: 'pixel:gaming' },
    {
      label: 'Instagram',
      href: 'https://www.instagram.com/thresholdsungames',
      icon: 'pixel:instagram',
    },
    // { label: 'YouTube', href: '#', icon: 'pixel:youtube' },
    // { label: 'Bluesky', href: '#', icon: 'pixel:bluesky' },
  ],
} = Astro.props;
---

<section id="socials" class="scroll-target w-full px-2 pb-6 sm:px-30">
  <ul class="flex items-center justify-center gap-16">
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            aria-label={link.label}
            class="text-foreground hover:text-foreground/70 dark:text-foreground dark:hover:text-foreground/70 transition-colors duration-150"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon
              name={link.icon}
              size={48}
              class="w-10 h-10 sm:w-12 sm:h-12 hover:scale-110 motion-reduce:hover:scale-100"
            />
          </a>
        </li>
      ))
    }
  </ul>
</section>
