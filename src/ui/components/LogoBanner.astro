---
import Line from './Line.astro';

interface Props {
  alt?: string;
  width?: number;
  height?: number;
}

const { alt = 'Threshold Sun Games Logo', width = 512, height = 512 } = Astro.props;
---

<a href={import.meta.env.BASE_URL}>
  <section class="flex flex-col items-center py-4">
    <img
      src={`${import.meta.env.BASE_URL}logo/tsg_logo.svg`}
      alt={alt}
      width={width}
      height={height}
      class="max-w-[412px] w-full select-none dark:invert"
    />
  </section>
</a>
<Line />
