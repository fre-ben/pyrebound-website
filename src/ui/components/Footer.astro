---
import ThemeSwitcher from './ThemeSwitcher.astro';
---

<footer
  class="col-start-1 -col-end-1 bg-[repeating-linear-gradient(-32deg,transparent_0px,transparent_6px,#f2f2f2_6px,#f2f2f2_12px)] dark:bg-[repeating-linear-gradient(-32deg,transparent_0px,transparent_6px,#161616_6px,#161616_12px)]"
>
  <div class="flex justify-between gap-6 items-center max-w-3xl mx-auto p-4 border-x border-border">
    <p class="text-xs uppercase opacity-[.64]">
      &copy; {new Date().getFullYear()}
      Threshold Sun Games. <a href={`${import.meta.env.BASE_URL}imprint`} class="underline ml-4">imprint</a>
    </p>
    <div>
      <ThemeSwitcher />
    </div>
  </div>
</footer>
