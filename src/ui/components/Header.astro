---
interface NavLink {
  label: string;
  href: string;
}

interface Props {
  siteName: string;
  navLinks?: NavLink[];
}

const { siteName, navLinks = [] } = Astro.props;
---

<header class="col-start-2 p-4 border-x border-border">
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 items-center">
    <span class="select-none text-sm font-mono uppercase tracking-widest">{siteName}</span>
    <nav>
      <ul class="flex justify-end gap-4">
        {
          navLinks.map((item) => (
            <li>
              <a href={item.href} class="corner-effect select-none">
                <span class="corner" />
                <span class="relative z-10 block rounded-sm bg-card px-2 py-1 text-xs uppercase">
                  {item.label}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
