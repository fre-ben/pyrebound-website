---
interface NavLink {
  label: string;
  href: string;
}

interface Props {
  navLinks?: NavLink[];
}

const { navLinks = [] } = Astro.props;
---

<header
  class="col-start-2 p-4 border-x border-border sticky top-0 z-50 bg-background/80 backdrop-blur-sm"
>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 items-center">
    <a href={import.meta.env.BASE_URL} class="select-none text-sm font-mono uppercase tracking-widest"
      >Threshold Sun Games</a
    >
    <nav>
      <ul class="flex justify-end gap-4">
        {
          navLinks.map((item) => (
            <li>
              <a href={item.href} class="corner-effect select-none">
                <span class="corner" />
                <span class="relative z-10 block rounded-sm bg-card px-2 py-1 text-xs uppercase">
                  {item.label}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
