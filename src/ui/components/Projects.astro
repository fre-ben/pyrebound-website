---
import { Icon } from 'astro-icon/components';
import Dialog from './Dialog.astro';

interface Props {
  title?: string;
  description?: string;
  imageSrc?: string;
  imageAlt?: string;
  ctaLabel?: string;
  ctaUrl?: string;
}

const {
  title = 'Pyrebound',
  description = 'Pyrebound is a top-down exploration adventure game in which the player is always trying to move further into the darkness by burning pyres made from corpses of the undead in an  unconventional, non-stationary tower defense-style loop.',
  imageSrc = `${import.meta.env.BASE_URL}games/pyrebound/splash_main_torch_type.png`,
  imageAlt = 'Pyrebound – hooded figure with flame and sword',
  ctaLabel = 'Wishlist on Steam',
} = Astro.props;
---

<section id="projects" class="scroll-target w-full px-2 pb-6 sm:px-4">
  <div class="grid grid-cols-1 sm:grid-cols-2 bg-card overflow-hidden">
    <div class="overflow-hidden">
      <img
        src={imageSrc}
        alt={imageAlt}
        width={512}
        height={512}
        class="w-full h-full object-cover select-none"
      />
    </div>
    <div class="flex flex-col justify-between gap-4 p-6">
      <div class="flex flex-col gap-3">
        <h2 class="text-xl font-mono uppercase tracking-widest">{title}</h2>
        <p class="text-sm text-foreground">{description}</p>
      </div>

      <a href={`${import.meta.env.BASE_URL}games/pyrebound`} class="corner-effect select-none self-center">
        <span class="corner"></span>
        <span
          class="relative z-10 flex items-center gap-2 px-4 py-2 text-s whitespace-nowrap uppercase bg-primary text-primary-foreground"
        >
          More info
        </span>
      </a>

      <button
        id="cta-btn"
        class="corner-effect select-none self-center cursor-pointer"
        aria-haspopup="dialog"
        aria-controls="coming-soon-dialog"
      >
        <span class="corner"></span>
        <span
          class="relative z-10 flex items-center gap-2 px-4 py-2 text-s whitespace-nowrap uppercase bg-primary text-primary-foreground"
        >
          <Icon name="pixel:steam" size={24} />
          {ctaLabel}
        </span>
      </button>
    </div>
  </div>
</section>

<Dialog id="coming-soon-dialog" title="Not yet available">
  <p class="text-base text-foreground">
    The Steam page for <span class="font-mono uppercase">Pyrebound</span> isn't live yet. <br
    />Please check again later.
  </p>
</Dialog>

<script>
  const dialog = document.getElementById('coming-soon-dialog') as HTMLDialogElement | null;
  const openBtn = document.getElementById('cta-btn');

  openBtn?.addEventListener('click', () => dialog?.showModal());
</script>
